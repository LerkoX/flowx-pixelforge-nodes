{
  "name": "image-person-mask",
  "displayName": "SAM3 图像分割",
  "description": "SAM3 文本提示图像分割：prompt='the head and hair'/'person' → 像素级灰度蒙版（白=选中）。精准抠头填白/清背景的场景比矩形擦除干净得多。权重复用服务端 sam3-video 目录。",
  "category": "mask",
  "version": "1.0.0",
  "language": "python",
  "tags": [
    "mask",
    "sam3",
    "segment",
    "text-prompt",
    "image"
  ],
  "inputs": [],
  "outputs": [
    {
      "name": "mask",
      "type": "IMAGE"
    },
    {
      "name": "count",
      "type": "integer"
    },
    {
      "name": "coverage",
      "type": "float"
    },
    {
      "name": "width",
      "type": "integer"
    },
    {
      "name": "height",
      "type": "integer"
    },
    {
      "name": "bbox_x",
      "type": "integer"
    },
    {
      "name": "bbox_y",
      "type": "integer"
    },
    {
      "name": "bbox_w",
      "type": "integer"
    },
    {
      "name": "bbox_h",
      "type": "integer"
    }
  ],
  "parameters": [
    {
      "name": "service_url",
      "type": "string",
      "required": true
    },
    {
      "name": "service_url_host",
      "type": "string",
      "required": false,
      "default": "",
      "description": "Studio 宿主机侧（画布）可达的服务地址：模型列表查询、预览帧/重放/中断中转都由 Studio 发请求，用的是 Studio 的网络视角。docker 节点的 service_url 只能填容器内网地址（如 http://172.17.0.1:8100），Studio（手机/外网侧）取不到——此时把本参数绑成 Studio 可达地址（通常绑 {{ Param.service_url }} 公网隧道），否则画布上没有模型下拉数据、也看不到实时预览。留空则同 service_url"
    },
    {
      "name": "service_token",
      "type": "string",
      "required": false,
      "default": ""
    },
    {
      "name": "image",
      "type": "string",
      "required": true
    },
    {
      "name": "prompt",
      "type": "string",
      "required": false,
      "default": "person",
      "description": "英文名词短语：person / the head and hair / face …"
    },
    {
      "name": "obj_pick",
      "type": "string",
      "required": false,
      "default": "all",
      "description": "all=所有检出并集 / best=仅最高分"
    },
    {
      "name": "threshold",
      "type": "float",
      "required": false,
      "default": 0.5
    },
    {
      "name": "dilate",
      "type": "integer",
      "required": false,
      "default": 0,
      "description": "外扩像素（抠头填白建议 6~10）"
    },
    {
      "name": "pad",
      "type": "integer",
      "required": false,
      "default": 0,
      "description": "bbox 外扩像素（bbox 输出用；裁剪特写建议 30~60）"
    },
    {
      "name": "fill_holes",
      "type": "integer",
      "required": false,
      "default": 0,
      "description": "内部孔洞填充（0/1）：抠头/头发时开——SAM3 会选中发丝但漏掉被包围的脸"
    }
  ],
  "executor": {
    "supportedTypes": [
      "local",
      "docker"
    ],
    "preferredType": "local",
    "bundled": true
  },
  "ui": {
    "entry": "ui/node-widget.js",
    "width": 340,
    "height": 460,
    "collapsed": false,
    "apiVersion": 1
  },
  "files": [
    "flowx_client.py",
    "executor_base.py",
    "server_op.py"
  ],
  "entry": "main.py",
  "author": "flowx-team",
  "icon": "🎯",
  "mock": {
    "enabled": true,
    "entry": "mock.py"
  },
  "timeout": 600,
  "image": "lerkobba/flowx-pixelforge-nodes:v1.20.2"
}
